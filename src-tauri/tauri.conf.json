{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SSD Sentinel",
  "version": "1.10.3",
  "identifier": "com.ssdsentinel.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SSD Sentinel",
        "width": 1400,
        "height": 940,
        "minWidth": 860,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#0c0f14",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Disk health, SMART and diagnostics",
    "category": "Utility",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": {
      "../tools/smartmontools/": "smartmontools/",
      "../THIRD_PARTY.md": "THIRD_PARTY.md",
      "../LICENSE": "LICENSE"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["English", "Turkish"]
      }
    }
  }
}
