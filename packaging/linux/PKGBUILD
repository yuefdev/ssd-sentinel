# Maintainer: SSD Sentinel Contributors <https://github.com/yuefdev/ssd-sentinel>
pkgname=ssd-sentinel
pkgver=1.11.0
pkgrel=1
pkgdesc="Pure-Rust storage diagnostics, io_uring benchmark, surface repair, and file recovery"
arch=('x86_64' 'aarch64')
url="https://github.com/yuefdev/ssd-sentinel"
license=('MIT')
depends=('glibc' 'gcc-libs')
optdepends=(
  'smartmontools: extended SAT/NVMe vendor health details'
  'udisks2: zero-root D-Bus SMART telemetry'
  'polkit: graphical admin elevation for raw sector inspection & tuning'
  'libgl: OpenGL/EGL hardware rendering for native GUI'
)
makedepends=('cargo')
options=('!lto')

prepare() {
  cd "${startdir}/../../src-tauri"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "${startdir}/../../src-tauri"
  cargo build --release --locked --offline --no-default-features --features native-gui
}

package() {
  cd "${startdir}/../.."
  install -Dm755 "src-tauri/target/release/ssd-sentinel" "${pkgdir}/usr/bin/ssd-sentinel"
  install -Dm644 "packaging/linux/com.ssdsentinel.desktop.desktop" "${pkgdir}/usr/share/applications/com.ssdsentinel.desktop.desktop"
  install -Dm644 "packaging/linux/com.ssdsentinel.desktop.metainfo.xml" "${pkgdir}/usr/share/metainfo/com.ssdsentinel.desktop.metainfo.xml"
  install -Dm644 "packaging/linux/com.ssdsentinel.desktop.policy" "${pkgdir}/usr/share/polkit-1/actions/com.ssdsentinel.desktop.policy"
  install -Dm644 "src-tauri/icons/32x32.png" "${pkgdir}/usr/share/icons/hicolor/32x32/apps/com.ssdsentinel.desktop.png"
  install -Dm644 "src-tauri/icons/128x128.png" "${pkgdir}/usr/share/icons/hicolor/128x128/apps/com.ssdsentinel.desktop.png"
  install -Dm644 "src-tauri/icons/icon.png" "${pkgdir}/usr/share/icons/hicolor/256x256/apps/com.ssdsentinel.desktop.png"
  install -Dm644 "LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
